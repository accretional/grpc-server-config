# CumulativeTimeSeries: HTTP GET 200 request count — BEFORE a counter reset.
# The process ran from epoch_start for 3 minutes before restarting.
#
# After a counter reset (process restart, rollover, etc.) the correct model
# is a NEW CumulativeTimeSeries with a fresh epoch_start (see
# request_count_post_reset.textproto) — NOT a mutation of this series.
# This makes resets structurally visible rather than requiring out-of-band
# detection of decreasing counters.
#
# point[i] end time = epoch_start + sum(point[0..i].duration)
#   point[0] end: 00:01:00  (60s since epoch_start)
#   point[1] end: 00:02:00  (60s since point[0])
#   point[2] end: 00:03:00  (60s since point[1]) — process restarts shortly after
#
# proto: metrics.CumulativeTimeSeries

metric: {
  type: "server/http/request_count"
  labels: { key: "method" value: "GET"  }
  labels: { key: "status" value: "200"  }
  labels: { key: "host"   value: "web-01" }
}
resource: {
  id: 1001
  name: "web-01"
  type: "compute/instance"
}
epoch_start: { seconds: 1745798400 }  # 2026-04-28 00:00:00 UTC

points: { duration: { seconds: 60 } value: { int64_value: 1200 } }
points: { duration: { seconds: 60 } value: { int64_value: 2450 } }
points: { duration: { seconds: 60 } value: { int64_value: 3700 } }
