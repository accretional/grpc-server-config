# GaugeTimeSeries: HTTP request latency distribution over two 1-minute windows.
# Demonstrates: DISTRIBUTION gauge values with exponential bucket options.
# Useful for ALIGN_PERCENTILE_99/95/50/05 and REDUCE_PERCENTILE_* tests.
#
# Buckets (exponential, scale=1ms, growth_factor=4, 8 finite buckets):
#   0: underflow  (-∞,  1ms)
#   1:            [ 1ms,   4ms)
#   2:            [ 4ms,  16ms)
#   3:            [16ms,  64ms)   ← bulk of requests
#   4:            [64ms, 256ms)
#   5:           [256ms,   1s)
#   6:             [1s,    4s)
#   7:             [4s,   16s)
#   8: overflow   [16s,    +∞)
#
# proto: metrics.GaugeTimeSeries

metric: {
  type: "server/http/request_latency"
  labels: { key: "handler" value: "/api/v1/query" }
  labels: { key: "host"    value: "web-01"         }
}
resource: {
  id: 1001
  name: "web-01"
  type: "compute/instance"
}

# Window ending at T+1min — moderate load, p99 ~ 256ms
points: {
  at: { seconds: 1745798460 }
  value: {
    distribution_value: {
      count: 100
      mean: 38.5
      sum_of_squared_deviation: 95000.0
      range: { min: 2.1 max: 287.0 }
      bucket_options: {
        exponential_buckets: {
          num_finite_buckets: 8
          growth_factor: 4.0
          scale: 1.0
        }
      }
      # [underflow, 1-4ms, 4-16ms, 16-64ms, 64-256ms, 256ms-1s, 1-4s, 4-16s, overflow]
      bucket_counts: [0, 5, 28, 42, 20, 4, 1, 0, 0]
    }
  }
}

# Window ending at T+2min — higher load, tail latency worse
points: {
  at: { seconds: 1745798520 }
  value: {
    distribution_value: {
      count: 150
      mean: 52.3
      sum_of_squared_deviation: 210000.0
      range: { min: 1.8 max: 892.0 }
      bucket_options: {
        exponential_buckets: {
          num_finite_buckets: 8
          growth_factor: 4.0
          scale: 1.0
        }
      }
      bucket_counts: [0, 4, 30, 60, 40, 12, 3, 1, 0]
    }
  }
}
