# CumulativeTimeSeries: HTTP GET 200 request count — AFTER a counter reset.
# A new epoch_start marks the restart; the counter begins from zero again.
#
# Compare with request_count_pre_reset.textproto. The two series are separate
# messages; the structural gap between the previous series' last end time
# (1745798400 + 180 = 1745798580) and this epoch_start (1745798640) is the
# full record of when the restart occurred (~60s gap).
#
# point[i] end time = epoch_start + sum(point[0..i].duration)
#   point[0] end: 00:05:00  (60s since new epoch_start)
#   point[1] end: 00:06:00  (60s since point[0])
#   point[2] end: 00:07:00  (60s since point[1])
#
# proto: metrics.CumulativeTimeSeries

metric: {
  type: "server/http/request_count"
  labels: { key: "method" value: "GET"  }
  labels: { key: "status" value: "200"  }
  labels: { key: "host"   value: "web-01" }
}
resource: {
  id: 1001
  name: "web-01"
  type: "compute/instance"
}
# New epoch after restart — ~60s after the previous series ended.
epoch_start: { seconds: 1745798640 }  # 2026-04-28 00:04:00 UTC

points: { duration: { seconds: 60 } value: { int64_value: 800  } }
points: { duration: { seconds: 60 } value: { int64_value: 1950 } }
points: { duration: { seconds: 60 } value: { int64_value: 3100 } }
