# GaugeTimeSeries: CPU utilization on web-01 over ~6 minutes.
# Demonstrates: DOUBLE gauge values, a deliberate gap (minute 4 is missing)
# to exercise ALIGN_INTERPOLATE and ALIGN_NEXT_OLDER behaviour.
#
# proto: metrics.GaugeTimeSeries

metric: {
  type: "server/cpu/utilization"
  labels: { key: "host"  value: "web-01" }
  labels: { key: "zone"  value: "us-central1-a" }
}
resource: {
  id: 1001
  name: "web-01"
  type: "compute/instance"
}
# T+0 min — 2026-04-28 00:00:00 UTC
points: { at: { seconds: 1745798400 } value: { double_value: 0.42 } }
# T+1 min
points: { at: { seconds: 1745798460 } value: { double_value: 0.58 } }
# T+2 min
points: { at: { seconds: 1745798520 } value: { double_value: 0.61 } }
# T+3 min
points: { at: { seconds: 1745798580 } value: { double_value: 0.55 } }
# T+4 min intentionally missing — gap for aligner edge-case testing
# T+5 min
points: { at: { seconds: 1745798700 } value: { double_value: 0.47 } }
# T+6 min — spike, useful for ALIGN_MAX / ALIGN_STDDEV tests
points: { at: { seconds: 1745798760 } value: { double_value: 0.91 } }
