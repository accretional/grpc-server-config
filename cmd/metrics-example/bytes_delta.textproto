# DeltaTimeSeries: bytes sent on eth0 in contiguous 60-second windows.
# Demonstrates: INT64 delta values, contiguous non-overlapping windows.
# Useful for ALIGN_RATE (bytes/s), ALIGN_SUM, ALIGN_MEAN tests.
#
# series_start = 00:00:00
# Window [00:00, 00:01): 1 MiB sent — moderate traffic
# Window [00:01, 00:02): 2 MiB sent — traffic doubled
# Window [00:02, 00:03): 0.75 MiB — traffic dropped
# Window [00:03, 00:04): 3 MiB   — burst
#
# proto: metrics.DeltaTimeSeries

metric: {
  type: "server/network/bytes_sent"
  labels: { key: "interface" value: "eth0"   }
  labels: { key: "host"      value: "web-01" }
}
resource: {
  id: 1001
  name: "web-01"
  type: "compute/instance"
}
start: { seconds: 1745798400 }  # 2026-04-28 00:00:00 UTC

points: { duration: { seconds: 60 } value: { int64_value: 1048576 } }  # 1 MiB
points: { duration: { seconds: 60 } value: { int64_value: 2097152 } }  # 2 MiB
points: { duration: { seconds: 60 } value: { int64_value: 786432  } }  # 0.75 MiB
points: { duration: { seconds: 60 } value: { int64_value: 3145728 } }  # 3 MiB
